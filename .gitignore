.DS_Store
node_modules/
*.log

# ---------------------------------------------------------------
# Data-loading migrations are NOT tracked.
#
# A migration that loads real rows embeds real families — names, parent
# phone numbers, home addresses — as SQL literals. Those files are one-off
# loads: schema_migrations records them by basename + sha256, and the
# ledger lives in the database, so nothing needs the file in git to know
# it ran.
#
# The DDL, the functions and the checks are committed; only the row data
# is kept out. Copies live beside the export they came from, in
# ../_archive/genalpha-premerge-*/ .
#
# See supabase/migrations/DATA-MIGRATIONS.md.
# ---------------------------------------------------------------
supabase/migrations/*-genalpha-admission-reload.sql
supabase/migrations/*-genalpha-merge-gaps.sql
supabase/migrations/*-reminder-event-details-*.sql
supabase/migrations/*-wa-flow-event-details-*.sql
supabase/migrations/*-wa-flow-details-fix-*.sql

# Purged from git history 2026-08-12. These five migrations embed 112 real
# family phone numbers, children's names and home addresses as SQL literals.
# They stay ON DISK because schema_migrations records applied files by
# basename + sha256 and PLATFORM.md forbids renaming or moving an applied
# file — but they must never be committed again.
supabase/migrations/2026-08-11b-genalpha-core.sql
supabase/migrations/2026-08-11c-genalpha-history.sql
supabase/migrations/2026-08-11d-genalpha-timeline.sql
supabase/migrations/2026-08-11kz-genalpha-messaging.sql
supabase/migrations/2026-08-11m-genalpha-admissions.sql

# Playwright page snapshots captured 44 and 46 real member names.
.playwright-cli/

# Rendered media: 1.6 GB of mp4/webm/wav lived in history. Regenerable output.
*.mp4
*.webm
*.wav
*.mp3

# ---------------------------------------------------------------
# Rendered/scratch output. NOT tracked and NOT ignorable-by-accident.
#
# output/playwright/matchpoint-reel-4k/site-copy/login.html carries a
# staff email AND password prefilled in value= attributes. It was
# untracked but NOT ignored — one `git add .` from being published, which
# is exactly how MatchPoint's README ended up with a live credential on
# public GitHub. Ignoring it removes the accident.
# ---------------------------------------------------------------
output/
supabase/.temp/

# rendered console snapshots for local viewing — real GMV/MRR, never commit
.preview/
